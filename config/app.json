{
  "$schema": "../schemas/app-config.schema.json",
  "schema_version": 2,
  "app": {
    "title": "Prompt Batch Generator"
  },
  "paths": {
    "engine": "../batch_cli.py",
    "profiles": "../profiles",
    "state": "../state/gui-state.json",
    "default_output_root": "../../generations/prompt-batches",
    "model_config": "../../llama-swap/config.yaml",
    "router_executable": "../../llama-swap/llama-swap.exe",
    "router_working_directory": "../../llama-swap",
    "runtime_executable": "../../llama-current/llama-server.exe"
  },
  "backend": {
    "adapter": "openai-chat-completions",
    "base_url": "http://127.0.0.1:8081/v1",
    "models_endpoint": "/models",
    "chat_endpoint": "/chat/completions",
    "request_timeout_seconds": 3600,
    "readiness_timeout_seconds": 60,
    "request_body": {},
    "auth": {
      "type": "none"
    }
  },
  "router": {
    "arguments": [
      "--config",
      "config.yaml",
      "--listen",
      "127.0.0.1:8081"
    ],
    "managed_process_names": [
      "llama-swap",
      "llama-server"
    ]
  },
  "runtime": {
    "version_arguments": [
      "--version"
    ]
  },
  "model_source": {
    "fallback_format": "llama-swap-yaml",
    "grouping": {
      "enabled": true,
      "pattern": "^([^-]+)",
      "match_group": 1,
      "fallback_group": "other",
      "fallback_label": "其他",
      "aliases": {
        "qwen3.6": "Qwen 3.6",
        "gemma4": "Gemma 4",
        "ornith": "Ornith",
        "qwen3": "Qwen 3",
        "muse": "Muse"
      },
      "order": [
        "qwen3.6",
        "gemma4",
        "ornith",
        "qwen3",
        "muse"
      ],
      "parameter_tiers": {
        "enabled": true,
        "pattern": "(?:^|-)(\\d+(?:\\.\\d+)?[bB])(?:-a(\\d+(?:\\.\\d+)?[bB]))?(?:-|$)",
        "size_group": 1,
        "active_group": 2,
        "fallback_group": "unknown",
        "fallback_label": "参数量未标注",
        "sort": "size-desc"
      }
    }
  },
  "defaults": {
    "profile": "h3",
    "mode": "auto",
    "repeats": 3,
    "max_tokens": 8192,
    "seed_base": 1,
    "remember_direct_input": false
  }
}
