{
  "$schema": "../schemas/profile.schema.json",
  "schema_version": 1,
  "id": "h3",
  "display_name": "MiniMax H3 Prompt",
  "description": "MiniMax H3 五种 mode 的结构化 prompt 生成。",
  "system_prompt_root": "${USERPROFILE}/ROOT/Workspaces/Minimax-H3-Skill",
  "default_mode": "t2va",
  "allow_auto_mode": true,
  "mode_detection": {
    "type": "first_nonempty_line",
    "case_sensitive": false
  },
  "modes": {
    "t2va": {
      "display_name": "T2VA",
      "system_prompt": "t2va_distill.md",
      "validation": {
        "required_patterns": [
          "(?m)^integrated_multimodal_description\\s*:",
          "(?m)^overall_soundscape\\s*:",
          "(?m)^non_diegetic_music\\s*:"
        ]
      }
    },
    "i2va": {
      "display_name": "I2VA",
      "system_prompt": "i2va_distill.md",
      "validation": {
        "required_patterns": [
          "(?m)^integrated_multimodal_description\\s*:",
          "(?m)^overall_soundscape\\s*:",
          "(?m)^non_diegetic_music\\s*:"
        ]
      }
    },
    "fl2va": {
      "display_name": "FL2VA",
      "system_prompt": "fl2va_distill.md",
      "validation": {
        "required_patterns": [
          "(?m)^integrated_multimodal_description\\s*:",
          "(?m)^overall_soundscape\\s*:",
          "(?m)^non_diegetic_music\\s*:"
        ]
      }
    },
    "l2va": {
      "display_name": "L2VA",
      "system_prompt": "l2va_distill.md",
      "validation": {
        "required_patterns": [
          "(?m)^integrated_multimodal_description\\s*:",
          "(?m)^overall_soundscape\\s*:",
          "(?m)^non_diegetic_music\\s*:"
        ]
      }
    },
    "ref2va": {
      "display_name": "Ref2VA",
      "system_prompt": "ref2va_distill.md",
      "validation": {
        "required_patterns": [
          "(?m)^subject_definitions\\s*:",
          "(?m)^summary\\s*:",
          "(?m)^retention_analysis\\s*:",
          "(?m)^detailed_description\\s*:",
          "(?m)^overall_soundscape\\s*:",
          "(?m)^non_diegetic_music\\s*:"
        ]
      }
    }
  },
  "validation": {
    "required_patterns": [],
    "forbidden_patterns": []
  },
  "observations": [
    {
      "id": "quoted-trigger",
      "input_pattern": "\"([^\"]+)\"",
      "text_group": 1,
      "marker_group": 0,
      "remove_marker_in_final": true
    }
  ],
  "output": {
    "run_prefix": "h3-prompts",
    "aggregate_title": "MiniMax H3 Final Prompts",
    "summary_title": "H3 Prompt Generation Summary",
    "all_outputs_file": "ALL-PROMPTS.md",
    "raw_outputs_file": "ALL-PROMPTS-RAW.md",
    "records_file": "GENERATION-RECORDS.csv",
    "observations_file": "TRIGGER-CHECK.csv",
    "summary_file": "GENERATION-SUMMARY.md"
  }
}
