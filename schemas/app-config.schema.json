{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/prompt-batch-tool/app-config.schema.json",
  "title": "Prompt Batch Generator application config",
  "type": "object",
  "required": ["schema_version", "paths", "backend", "router", "runtime", "gpu_monitor", "result_browser"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 4},
    "app": {"type": "object"},
    "paths": {
      "type": "object",
      "required": [
        "engine", "profiles", "state", "default_output_root", "model_config",
        "router_executable", "router_working_directory", "runtime_executable"
      ],
      "additionalProperties": {"type": "string"}
    },
    "backend": {
      "type": "object",
      "required": [
        "adapter", "base_url", "models_endpoint", "chat_endpoint",
        "request_timeout_seconds", "readiness_timeout_seconds"
      ],
      "properties": {
        "adapter": {"const": "openai-chat-completions"},
        "base_url": {"type": "string", "minLength": 1},
        "models_endpoint": {"type": "string", "minLength": 1},
        "chat_endpoint": {"type": "string", "minLength": 1},
        "request_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "readiness_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "request_body": {"type": "object"},
        "auth": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type"],
              "properties": {"type": {"const": "none"}},
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["type", "environment_variable"],
              "properties": {
                "type": {"const": "environment"},
                "environment_variable": {"type": "string", "minLength": 1},
                "header": {"type": "string", "minLength": 1},
                "prefix": {"type": "string"}
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "router": {
      "type": "object",
      "required": [
        "arguments", "managed_process_names", "control_base_url",
        "unload_all_endpoint", "control_timeout_seconds"
      ],
      "properties": {
        "arguments": {"type": "array", "items": {"type": "string"}},
        "managed_process_names": {"type": "array", "items": {"type": "string"}},
        "control_base_url": {"type": "string", "minLength": 1},
        "unload_all_endpoint": {"type": "string", "minLength": 1},
        "control_timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["version_arguments"],
      "properties": {
        "version_arguments": {"type": "array", "items": {"type": "string"}}
      }
    },
    "gpu_monitor": {
      "type": "object",
      "required": ["enabled", "command", "poll_interval_ms", "history_samples", "query_timeout_seconds"],
      "properties": {
        "enabled": {"type": "boolean"},
        "command": {"type": "string", "minLength": 1},
        "poll_interval_ms": {"type": "integer", "minimum": 250, "maximum": 60000},
        "history_samples": {"type": "integer", "minimum": 10, "maximum": 600},
        "query_timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "result_browser": {
      "type": "object",
      "required": ["max_entries"],
      "properties": {
        "max_entries": {"type": "integer", "minimum": 1, "maximum": 100}
      },
      "additionalProperties": false
    },
    "model_source": {"type": "object"},
    "defaults": {
      "type": "object",
      "properties": {
        "seed_base": {"type": "integer", "minimum": 1},
        "random_seed": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
