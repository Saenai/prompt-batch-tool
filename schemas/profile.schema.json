{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/prompt-batch-tool/profile.schema.json",
  "title": "Prompt Batch Generator profile",
  "type": "object",
  "required": ["schema_version", "id", "default_mode", "modes"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string"},
    "description": {"type": "string"},
    "system_prompt_root": {"type": "string"},
    "default_mode": {"type": "string", "minLength": 1},
    "allow_auto_mode": {"type": "boolean"},
    "mode_detection": {"type": "object"},
    "request_body": {"type": "object"},
    "modes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "display_name": {"type": "string"},
          "system_prompt": {"type": "string", "minLength": 1},
          "system_prompt_text": {"type": "string"},
          "request_body": {"type": "object"},
          "validation": {"$ref": "#/$defs/validation"}
        },
        "additionalProperties": true
      }
    },
    "validation": {"$ref": "#/$defs/validation"},
    "observations": {"type": "array", "items": {"type": "object"}},
    "output": {"type": "object"}
  },
  "$defs": {
    "validation": {
      "type": "object",
      "properties": {
        "required_patterns": {"type": "array", "items": {"type": "string"}},
        "forbidden_patterns": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
